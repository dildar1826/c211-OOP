/* ==========================================================
   TASK #1: RECTANGLE CLASS (Using Constructors)
   ========================================================== */
class Rectangle {
private:
    int length;
    int width;

public:
    // Default Constructor
    Rectangle() {
        length = 0;
        width = 0;
    }

    // Parameterized Constructor with validation
    Rectangle(int l, int w) {
        setLength(l);
        setWidth(w);
    }

    // Setter functions with validation
    void setLength(int l) {
        if (l > 0) 
            length = l;
        else {
            cout << "Invalid length! Must be greater than zero." << endl;
            length = 0;
        }
    }

    void setWidth(int w) {
        if (w > 0) {
            width = w;
        } else {
            cout << "Invalid width! Must be greater than zero." << endl;
            width = 0;
        }
    }

    // Getter functions
    int getLength() { return length; }
    int getWidth() { return width; }

    // Area and Perimeter calculations
    int calculateArea() { return length * width; }
    int calculatePerimeter() { return 2 * (length + width); }

    // Predicate function to check if it's a square
    bool isSquare() {
        return length == width && length > 0;
    }
};

