/* ==========================================================
   TASK #2: TIME CLASS (Using Constructors)
   ========================================================== */
class Time {
private:
    int hours;
    int minutes;
    int seconds;

public:
    // Default Constructor (Initializes to 00:00:00)
    Time() {
        hours = 0;
        minutes = 0;
        seconds = 0;
    }

    // Parameterized Constructor
    Time(int h, int m, int s) {
        setTime(h, m, s);
    }

    void setHour(int h) {
        if (h >= 0 && h <= 23) hours = h;
        else hours = 0;
    }   

    void setMinute(int m) {
        if (m >= 0 && m <= 59) minutes = m;
        else minutes = 0;
    }

    void setSecond(int s) {
        if (s >= 0 && s <= 59) seconds = s;
        else seconds = 0;
    }

    void setTime(int h, int m, int s) {
        if (h >= 0 && h <= 23 && m >= 0 && m <= 59 && s >= 0 && s <= 59) {
            hours = h;
            minutes = m;
            seconds = s;
        } else {
            cout << "Invalid time values!" << endl;
            hours = 0;
            minutes = 0;
            seconds = 0;
        }
    }

    int getHour() { return hours; }
    int getMinute() { return minutes; }
    int getSecond() { return seconds; }  

    void incSec(int s = 1) {
        if (s < 0) return; // Prevent negative increments
        seconds += s;
        if (seconds >= 60) {
            int extraMinutes = seconds / 60;
            seconds = seconds % 60;
            minutes += extraMinutes;
            if (minutes >= 60) {
                int extraHours = minutes / 60;
                minutes = minutes % 60;
                hours = (hours + extraHours) % 24;
            }
        }
    }

    void printTwelveHourFormat() {
        int twelveHourFormat = hours % 12;
        if (twelveHourFormat == 0) twelveHourFormat = 12;
        char period = (hours >= 12) ? 'P' : 'A'; 
        cout << twelveHourFormat << "h:" << minutes << "m:" << seconds << "s " << period << "M" << endl;
    }

    void twentyFourHourFormat() {
        cout << hours << "h:" << minutes << "m:" << seconds << "s" << endl;
    }
};

