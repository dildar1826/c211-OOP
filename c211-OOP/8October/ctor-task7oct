/* ==========================================================
   TASK #3: STUDENT CLASS (Using Constructors)
   ========================================================== */
class Student {
private:
    char rollNo[11];
    int semester;
    float cgpa;
    char name[50];

    void myStrcpy(char dest[], const char* src) {
        int i = 0;
        while (src[i] != '\0' && i < 49) {
            dest[i] = src[i];
            i++;
        }
        dest[i] = '\0';
    }

public:
    // Default Constructor
    Student() {
        myStrcpy(rollNo, "N/A");
        semester = 1;
        cgpa = 0.0f;
        myStrcpy(name, "Unknown");
    }

    // Parameterized Constructor
    Student(const char* r, int sem, float g, const char* n) {
        setRollNo(r);
        setSemester(sem);
        setGPA(g);
        setName(n);
    }

    void setRollNo(const char * r) {
        myStrcpy(rollNo, r);
    }

    void setSemester(int s) {
        if (s >= 1 && s <= 8) semester = s;
        else semester = 1;
    }

    void setName(const char * n) {
        myStrcpy(name, n);
    }

    void setGPA(float g) {
        if (g >= 0.0f && g <= 4.0f) cgpa = g;
        else cgpa = 0.0f;
    }

    const char * getRollNo() { return rollNo; }
    int getSemester() { return semester; }
    const char * getName() { return name; }
    float getGPA() { return cgpa; }

    bool isStudentDropout() {
        if (semester == 1 && cgpa < 1.5) return true;
        else if (semester == 2 && cgpa < 1.7) return true;
        return false;
    }
    
    bool isStudentOnProbation() {
        if (semester == 1 && cgpa >= 1.5 && cgpa < 2.0) return true;
        else if (semester == 2 && cgpa >= 1.7 && cgpa < 2.0) return true;
        return false;
    }
};

